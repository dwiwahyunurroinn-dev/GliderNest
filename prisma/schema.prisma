// Database lokal: SQLite (file prisma/dev.db) — tanpa instalasi server apa pun.
// Untuk produksi nanti bisa dimigrasi ke PostgreSQL (Neon/Supabase) dengan
// mengganti provider + adapter, tanpa mengubah halaman.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Glider {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  morph       String
  sex         String // "jantan" | "betina"
  ageMonths   Int
  price       Int
  status      String     @default("tersedia") // tersedia | dipesan | terjual
  stock       Int        @default(1) // jumlah ekor yang tersedia pada listing ini
  description String
  lineage     String
  traits      String // dipisah koma
  imageUrl    String     @default("")
  featured    Boolean    @default(false)
  orders      Order[]
  stockLogs   StockLog[]
  // silsilah: indukan jantan (sire) & betina (dam)
  sire        Parent?    @relation("Sire", fields: [sireId], references: [id], onDelete: SetNull)
  sireId      String?
  dam         Parent?    @relation("Dam", fields: [damId], references: [id], onDelete: SetNull)
  damId       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Indukan penangkaran — sumber silsilah joey.
model Parent {
  id        String   @id @default(cuid())
  name      String
  morph     String
  sex       String // jantan | betina
  birthYear Int      @default(0)
  notes     String   @default("")
  imageUrl  String   @default("")
  sired     Glider[] @relation("Sire")
  mothered  Glider[] @relation("Dam")
  createdAt DateTime @default(now())
}

// Jejak aktivitas admin & sistem — untuk audit harian.
model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())
}

// Riwayat pergerakan stok — dasar laporan "stok masuk per periode".
model StockLog {
  id        String   @id @default(cuid())
  glider    Glider   @relation(fields: [gliderId], references: [id], onDelete: Cascade)
  gliderId  String
  change    Int // positif = masuk, negatif = keluar
  type      String // masuk | keluar
  note      String   @default("")
  createdAt DateTime @default(now())
}

// Notifikasi untuk admin (pesanan baru, stok habis, dll).
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String // paragraf dipisah baris kosong
  coverUrl  String   @default("")
  published Boolean  @default(true)
  publishAt DateTime @default(now()) // artikel tampil publik setelah waktu ini
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  city      String
  quote     String
  rating    Int      @default(5)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id            String   @id @default(cuid())
  code          String   @unique
  customerName  String
  phone         String
  address       String
  note          String   @default("")
  paymentMethod String // qris | transfer | dana
  status        String   @default("menunggu") // menunggu | diproses | dikirim | selesai | dibatalkan
  amount        Int
  glider        Glider?  @relation(fields: [gliderId], references: [id], onDelete: SetNull)
  gliderId      String?
  gliderName    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Koleksi gambar background website — dikelola dari panel admin;
// yang berstatus aktif dipakai sebagai latar hero & kartu ilustrasi.
model Background {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  id           Int    @id @default(1)
  siteName     String @default("GliderNest")
  tagline      String @default("Peternakan Sugar Glider Terpercaya")
  description  String @default("")
  whatsapp     String @default("6287734777846")
  email        String @default("halo@glidernest.id")
  instagram    String @default("glidernest.id")
  address      String @default("Sleman, Yogyakarta, Indonesia")
  openHours    String @default("Setiap hari, 09.00–20.00 WIB")
  mapsEmbedUrl String @default("")
  qrisImageUrl String @default("")
  bankAccounts String @default("") // per baris: BANK|NOMOR|ATAS NAMA
  danaNumber   String @default("")
  danaName     String @default("")
  codArea      String @default("") // area yang dilayani COD, contoh: "Sleman & Kota Yogyakarta"
  rekberInfo   String @default("") // jasa rekber yang didukung, satu per baris
  logoUrl      String @default("") // logo di header/footer; kosong = pakai maskot bawaan
  mascotUrl    String @default("") // gambar maskot kustom; kosong = pakai maskot SVG bawaan
  faviconUrl   String @default("") // ikon tab/alamat browser; kosong = favicon bawaan
  // hash password admin (scrypt, format salt:hash) — menggantikan ADMIN_PASSWORD
  // di .env begitu diisi lewat menu Pengaturan → Keamanan
  adminPasswordHash String @default("")
  foundedYear  Int    @default(2019)
}
